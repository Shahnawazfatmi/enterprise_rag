# Required
OPENAI_API_KEY=                         # answers (primary LLM); OPEN_AI_API_KEY also works
GEMINI_API_KEY=                         # answers when OpenAI fails (fallback LLM)
FIRECRAWL_API_KEY=                      # nightly scraping

# Optional - defaults shown
# LLM_PROVIDER=openai                   # openai | gemini
# LLM_FALLBACK_PROVIDER=gemini          # openai | gemini | none
# OPENAI_MODEL=gpt-4.1-mini             # or gpt-5.4-mini
# OPENAI_REASONING_EFFORT=low           # gpt-5.x / o-series only
# GEMINI_MODEL=gemini-3.6-flash
# ALLOWED_ORIGINS=*                     # Docker default: https://rag.consiva.tech,https://uat.consiva.ai
# VITE_API_URL=https://apirag.consiva.tech/ask   # Docker frontend build only
# RATE_LIMIT_PER_MINUTE=20
# TOP_K=8
# MIN_RELEVANCE=0.38                    # below this similarity the bot says "not found"
# LLM_MAX_TOKENS=1500                   # safety cap only; answers are as long as their facts need
# NEXT_STEP_ENABLED=true                # link + follow-up question after answers (/ask/stream)
# NEXT_STEP_MIN_SCORE=0.45              # higher = fewer, safer next-step links
# NEXT_STEP_UTM=utm_source=chatbot      # added to next-step links
# LOGIN_URL=                            # e.g. https://app.consiva.ai/login - enables a "log in" next step
# ALERT_WEBHOOK_URL=                    # Slack/Teams webhook for pipeline failures
# HF_TOKEN=                             # faster, rate-limit-free model downloads
