# Required
GEMINI_API_KEY=                         # answers (LLM)
FIRECRAWL_API_KEY=                      # nightly scraping

# Optional - defaults shown
# LLM_PROVIDER=gemini                   # gemini | openai
# GEMINI_MODEL=gemini-3.6-flash
# OPENAI_API_KEY=                       # only for LLM_PROVIDER=openai; OPEN_AI_API_KEY also works
# OPENAI_MODEL=gpt-4.1-mini             # or gpt-5.4-mini
# OPENAI_REASONING_EFFORT=low           # gpt-5.x / o-series only
# ALLOWED_ORIGINS=*                     # Docker default: https://rag.consiva.tech
# VITE_API_URL=https://apirag.consiva.tech/ask   # Docker frontend build only
# RATE_LIMIT_PER_MINUTE=20
# TOP_K=8
# MIN_RELEVANCE=0.38                    # below this similarity the bot says "not found"
# ALERT_WEBHOOK_URL=                    # Slack/Teams webhook for pipeline failures
# HF_TOKEN=                             # faster, rate-limit-free model downloads
